{
  "contracts": {
    "place": {
      "capability": "shop.place",
      "version": 1,
      "kind": "action",
      "effects": "none",
      "summary": "Payload conformance contract",
      "config": {
        "type": "object",
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "us",
              "eu"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_ref",
          "quantity",
          "lines"
        ],
        "properties": {
          "order_ref": {
            "type": "string",
            "pattern": "^ord-[0-9]+$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/line"
            }
          }
        },
        "$defs": {
          "line": {
            "type": "object",
            "properties": {
              "sku": {
                "type": "string"
              }
            },
            "required": [
              "sku"
            ],
            "additionalProperties": false
          }
        }
      },
      "outcomes": {
        "placed": {
          "description": "Placed",
          "output": {
            "type": "object",
            "properties": {
              "po_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "held"
                ]
              }
            },
            "required": [
              "po_id",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "rejected": {
          "description": "Refused",
          "output": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "reason"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "label": {
      "capability": "brain.label",
      "version": 1,
      "kind": "ai",
      "effects": "none",
      "summary": "AI output conformance",
      "input": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "outcomes": {
        "labelled": {
          "description": "Label",
          "output": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "label",
              "confidence"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    "notify": {
      "capability": "shop.notify",
      "version": 1,
      "kind": "action",
      "effects": "none",
      "summary": "Format assertion (SPEC v0.1 §2)",
      "input": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "at",
          "day",
          "email",
          "id"
        ],
        "additionalProperties": false
      },
      "outcomes": {
        "sent": {
          "description": "Sent",
          "output": {
            "type": "object",
            "properties": {
              "link": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "link"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  },
